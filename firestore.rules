rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTripMemberDoc(data) {
      return signedIn() && (
        (('memberIds' in data) && data.memberIds is list && request.auth.uid in data.memberIds)
        || (('createdBy' in data) && data.createdBy == request.auth.uid)
      );
    }

    function isTripMember(tripId) {
      return isTripMemberDoc(get(/databases/$(database)/documents/trips/$(tripId)).data);
    }

    function isTripAdmin(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return signedIn() && (
        (('createdBy' in trip) && trip.createdBy == request.auth.uid)
        || (('memberIds' in trip) && trip.memberIds is list
          && request.auth.uid in trip.memberIds
          && ('adminIds' in trip) && trip.adminIds is list
          && request.auth.uid in trip.adminIds)
      );
    }

    function isTripClearing(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return 'clearOperation' in trip;
    }

    function canManageTripRecords(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return isTripAdmin(tripId)
        && (!('clearOperation' in trip)
          || (trip.clearOperation is map
            && trip.clearOperation.ownerUid == request.auth.uid));
    }

    function canManageSettlements(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return signedIn()
        && (trip.get('createdBy', '') == request.auth.uid
          || ((trip.get('memberIds', []) is list)
            && request.auth.uid in trip.get('memberIds', [])
            && (((trip.get('adminIds', []) is list)
                && request.auth.uid in trip.get('adminIds', []))
              || ((trip.get('settlementManagerIds', []) is list)
                && request.auth.uid in trip.get('settlementManagerIds', [])))));
    }

    function isSettlementPermissionUpdate(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      let managers = request.resource.data.get('settlementManagerIds', null);
      return isTripAdmin(tripId)
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'settlementManagerIds', 'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && managers is list
        && trip.get('memberIds', []) is list
        && trip.get('memberIds', []).hasAll(managers)
        && request.resource.data.updatedAt == request.time;
    }

    // A receipt uploader may append one verified-shaped receipt reference when
    // the trip creator has enabled member uploads. This does not permit edits to
    // existing receipt entries or any financial/expense fields. The private
    // upload API independently verifies membership, upload permission and object
    // metadata before the UI attempts this write.
    function isReceiptMetadataAppend(tripId, expenseId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      let oldFiles = resource.data.get('receiptFiles', {});
      let newFiles = request.resource.data.get('receiptFiles', {});
      let changes = newFiles.diff(oldFiles);
      let addedIds = changes.addedKeys();
      let fileId = request.resource.data.get('receiptAppendId', '');
      let receipt = newFiles[fileId];
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isTripMember(tripId)
        && trip.get('allowMemberReceiptUploads', false) == true
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptFiles', 'receiptAppendId'])
        && fileId != resource.data.get('receiptAppendId', '')
        && addedIds.size() == 1
        && addedIds.hasOnly([fileId])
        && changes.changedKeys().size() == 0
        && changes.removedKeys().size() == 0
        && fileId is string
        && fileId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && receipt is map
        && receipt.keys().hasAll(['provider', 'bucket', 'fileId', 'path', 'fileName', 'mimeType', 'size', 'uploadedAt'])
        && receipt.keys().hasOnly(['provider', 'bucket', 'fileId', 'path', 'fileName', 'mimeType', 'size', 'thumbnailPath', 'thumbnailMimeType', 'thumbnailSize', 'uploadedAt'])
        && receipt.provider == 'supabase'
        && receipt.bucket == 'contri-receipts'
        && receipt.fileId == fileId
        && receipt.path.matches('^trips/' + tripId + '/expenses/' + expenseId + '/' + fileId + '\\.(jpg|png|webp)$')
        && receipt.fileName is string
        && receipt.fileName.size() <= 160
        && receipt.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && receipt.size is int
        && receipt.size > 0
        && receipt.size <= 5242880
        && receipt.uploadedAt == request.time
        && ((!('thumbnailPath' in receipt) && !('thumbnailMimeType' in receipt) && !('thumbnailSize' in receipt))
          || (receipt.thumbnailPath == 'trips/' + tripId + '/expenses/' + expenseId + '/' + fileId + '.thumb.jpg'
            && receipt.thumbnailMimeType == 'image/jpeg'
            && receipt.thumbnailSize is int
            && receipt.thumbnailSize > 0
            && receipt.thumbnailSize <= 262144));
    }

    function isTripParticipant(tripId, uid) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return (('memberIds' in trip) && trip.memberIds is list && uid in trip.memberIds)
        || (('createdBy' in trip) && trip.createdBy == uid);
    }

    function isValidClearLockUpdate(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      let nextLock = request.resource.data.get('clearOperation', null);
      return isTripAdmin(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearOperation'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && (
          (!('clearOperation' in trip)
            && nextLock is map
            && nextLock.keys().hasOnly(['ownerUid', 'operationId', 'lockedAt'])
            && nextLock.ownerUid == request.auth.uid
            && nextLock.operationId is string
            && nextLock.operationId.size() > 0
            && nextLock.lockedAt == request.time)
          || ('clearOperation' in trip
            && trip.clearOperation is map
            && trip.clearOperation.ownerUid == request.auth.uid
            && nextLock is map
            && nextLock.ownerUid == request.auth.uid
            && nextLock.operationId == trip.clearOperation.operationId
            && nextLock.lockedAt == request.time)
          || ('clearOperation' in trip
            && trip.clearOperation is map
            && trip.clearOperation.lockedAt is timestamp
            && trip.clearOperation.lockedAt < request.time - duration.value(5, 'm')
            && nextLock is map
            && nextLock.keys().hasOnly(['ownerUid', 'operationId', 'lockedAt'])
            && nextLock.ownerUid == request.auth.uid
            && nextLock.operationId is string
            && nextLock.operationId.size() > 0
            && nextLock.lockedAt == request.time)
          || ('clearOperation' in trip
            && trip.clearOperation is map
            && trip.clearOperation.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearOperation'])
            && !('clearOperation' in request.resource.data))
        );
    }

    function validGuestFlag(member) {
      return !('isGuest' in member) || member.isGuest is bool;
    }

    function isValidTripCreation() {
      let data = request.resource.data;
      let creator = data.members[0];
      return signedIn()
        && data.keys().hasOnly([
          'name', 'description', 'emoji', 'startDate', 'endDate', 'currency', 'budget',
          'createdBy', 'members', 'memberIds', 'adminIds', 'createdAt', 'updatedAt'
        ])
        && data.createdBy == request.auth.uid
        && data.memberIds == [request.auth.uid]
        && data.adminIds == [request.auth.uid]
        && data.members.size() == 1
        && creator.uid == request.auth.uid
        && creator.role == 'admin'
        && creator.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'upiId', 'isGuest'])
        && (!('photoURL' in creator) || (creator.photoURL is string && creator.photoURL.size() <= 2048))
        && validGuestFlag(creator)
        && ((request.auth.token.firebase.sign_in_provider == 'anonymous' && creator.isGuest == true)
          || (request.auth.token.firebase.sign_in_provider != 'anonymous' && !('isGuest' in creator)))
        && data.name is string
        && data.name.size() > 0
        && data.currency is string
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isAdminTripDetailsUpdate(tripId) {
      return isTripAdmin(tripId)
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'emoji', 'startDate', 'endDate', 'currency', 'budget', 'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.currency is string;
    }

    // Receipt sharing is an optional, default-off setting. Only the specific
    // verified account that owns the trip may change this single field.
    // Per-member receipt viewing is separate from allowMemberReceiptUploads.
    // Only a trip admin may change the list, and every id must be a current member.
    function isReceiptViewPermissionUpdate(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      let viewers = request.resource.data.get('receiptViewerIds', null);
      return isTripAdmin(tripId)
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receiptViewerIds', 'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && viewers is list
        && trip.get('memberIds', []) is list
        && trip.get('memberIds', []).hasAll(viewers)
        && request.resource.data.updatedAt == request.time;
    }

    function isAuthorizedReceiptPermissionUpdate(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return signedIn()
        && request.auth.uid == trip.createdBy
        && request.auth.token.get('email', '') == 'tsmane8787@gmail.com'
        && request.auth.token.get('email_verified', false) == true
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'allowMemberReceiptUploads', 'updatedAt'
        ])
        && request.resource.data.get('allowMemberReceiptUploads', false) is bool
        && request.resource.data.updatedAt == request.time;
    }

    function isAdminInviteUpdate(tripId) {
      let addedIds = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      let addedMembers = request.resource.data.members.removeAll(resource.data.members);
      return isTripAdmin(tripId)
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members', 'memberIds', 'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && addedIds.size() == 1
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && addedMembers.size() == 1
        && addedMembers[0].uid == addedIds[0]
        && addedMembers[0].role == 'member'
        && addedMembers[0].keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'upiId', 'isGuest'])
        && (!('photoURL' in addedMembers[0]) || (addedMembers[0].photoURL is string && addedMembers[0].photoURL.size() <= 2048))
        && validGuestFlag(addedMembers[0])
        && request.resource.data.updatedAt == request.time;
    }

    function isAdminRoleUpdate(tripId) {
      let addedMembers = request.resource.data.members.removeAll(resource.data.members);
      let removedMembers = resource.data.members.removeAll(request.resource.data.members);
      let addedAdmins = request.resource.data.adminIds.removeAll(resource.data.adminIds);
      let removedAdmins = resource.data.adminIds.removeAll(request.resource.data.adminIds);
      let changedMember = addedMembers[0];
      let previousMember = removedMembers[0];
      return isTripAdmin(tripId)
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members', 'adminIds', 'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members.size() == resource.data.members.size()
        && addedMembers.size() == 1
        && removedMembers.size() == 1
        && changedMember.uid == previousMember.uid
        && changedMember.diff(previousMember).affectedKeys().hasOnly(['role'])
        && changedMember.role in ['admin', 'member']
        && request.resource.data.adminIds.size() > 0
        && request.resource.data.memberIds.hasAll(request.resource.data.adminIds)
        && (
          (previousMember.role == 'member' && changedMember.role == 'admin'
            && addedAdmins == [changedMember.uid] && removedAdmins.size() == 0)
          || (previousMember.role == 'admin' && changedMember.role == 'member'
            && removedAdmins == [changedMember.uid] && addedAdmins.size() == 0)
        )
        && request.resource.data.updatedAt == request.time;
    }

    function isSelfMemberProfileUpdate() {
      let addedMembers = request.resource.data.members.removeAll(resource.data.members);
      let removedMembers = resource.data.members.removeAll(request.resource.data.members);
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.members.size() == resource.data.members.size()
        && request.resource.data.updatedAt == request.time
        && addedMembers.size() == 1
        && removedMembers.size() == 1
        && addedMembers[0].uid == request.auth.uid
        && removedMembers[0].uid == request.auth.uid
        && addedMembers[0].diff(removedMembers[0]).affectedKeys().hasOnly(['name', 'upiId', 'photoURL'])
        && (!('photoURL' in addedMembers[0]) || (addedMembers[0].photoURL is string && addedMembers[0].photoURL.size() <= 2048));
    }

    function canCreateExpenseNotification(recipientUid, notificationId) {
      let tripId = request.resource.data.tripId;
      let expenseId = request.resource.data.expenseId;
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      let expense = getAfter(/databases/$(database)/documents/trips/$(tripId)/expenses/$(expenseId)).data;
      return signedIn()
        && !('clearOperation' in trip)
        && request.resource.data.keys().hasOnly([
          'type', 'tripId', 'tripName', 'expenseId', 'recipientUid', 'actorUid',
          'actorName', 'actorPhotoURL', 'expenseTitle', 'amount', 'currency', 'read', 'createdAt'
        ])
        && request.resource.data.type == 'expense_created'
        && request.resource.data.recipientUid == recipientUid
        && request.resource.data.actorUid == request.auth.uid
        && (!('actorPhotoURL' in request.resource.data)
          || (request.resource.data.actorPhotoURL is string
            && request.resource.data.actorPhotoURL.size() <= 2048
            && request.resource.data.actorPhotoURL == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL))
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && notificationId == tripId + '_' + expenseId
        && tripId is string
        && expenseId is string
        && request.resource.data.tripName == trip.name
        && request.auth.uid in trip.memberIds
        && recipientUid in trip.memberIds
        && expense.createdBy == request.auth.uid
        && request.resource.data.expenseTitle == expense.title
        && request.resource.data.amount == expense.amount
        && request.resource.data.currency == trip.currency;
    }

    function isSelfJoin(tripId) {
      let addedMemberIds = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      let addedMembers = request.resource.data.members.removeAll(resource.data.members);
      return signedIn()
        && !isTripClearing(tripId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['members', 'memberIds', 'updatedAt'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && addedMemberIds.size() == 1
        && addedMemberIds[0] == request.auth.uid
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && addedMembers.size() == 1
        && addedMembers[0].uid == request.auth.uid
        && addedMembers[0].role == 'member'
        && addedMembers[0].keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'upiId', 'isGuest'])
        && (!('photoURL' in addedMembers[0]) || (addedMembers[0].photoURL is string && addedMembers[0].photoURL.size() <= 2048))
        && (
          (request.auth.token.firebase.sign_in_provider == 'anonymous' && addedMembers[0].isGuest == true)
          || (request.auth.token.firebase.sign_in_provider != 'anonymous' && !('isGuest' in addedMembers[0]))
        )
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isSelf(uid)
        || (signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow create, update: if isSelf(uid);
      // Anonymous guests may delete only their own profile document. Shared trip,
      // expense, settlement, and receipt records are not user documents and stay
      // protected by the trip rules below.
      allow delete: if isSelf(uid)
        && request.auth.token.firebase.sign_in_provider == 'anonymous';

      match /notifications/{notificationId} {
        allow get: if isSelf(uid);
        allow list: if isSelf(uid)
          || (resource.data.tripId is string
            && isTripAdmin(resource.data.tripId)
            && isTripParticipant(resource.data.tripId, uid));
        allow create: if canCreateExpenseNotification(uid, notificationId);
        allow update: if isSelf(uid)
          && resource.data.read == false
          && request.resource.data.read == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isSelf(uid)
          || (resource.data.tripId is string
            && isTripAdmin(resource.data.tripId)
            && isTripParticipant(resource.data.tripId, uid));
      }
    }

    match /trips/{tripId} {
      allow create: if isValidTripCreation();

      allow get: if signedIn() && (resource == null || isTripMemberDoc(resource.data));
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow list: if signedIn()
        && ('createdBy' in resource.data)
        && resource.data.createdBy == request.auth.uid;
      allow update: if isAdminTripDetailsUpdate(tripId)
        || isAuthorizedReceiptPermissionUpdate(tripId)
        || isReceiptViewPermissionUpdate(tripId)
        || isSettlementPermissionUpdate(tripId)
        || isAdminInviteUpdate(tripId)
        || isAdminRoleUpdate(tripId)
        || isSelfJoin(tripId)
        || isValidClearLockUpdate(tripId)
        || isSelfMemberProfileUpdate();
      allow delete: if isTripAdmin(tripId) && !isTripClearing(tripId);

      // This is a deliberately small, invite-link-only projection. It contains
      // no member identities, expenses, settlements, or other trip document
      // fields. Knowing the existing trip ID is already the invite mechanism.
      match /invitationPreview/{previewId} {
        allow get: if previewId == 'current'
          && (resource == null || (resource.data.keys().hasOnly([
            'tripId', 'tripName', 'description', 'emoji', 'startDate', 'endDate', 'memberCount', 'updatedAt'
          ])
          && resource.data.tripId == tripId
          && resource.data.tripName is string
          && resource.data.description is string
          && resource.data.emoji is string
          && resource.data.startDate is string
          && resource.data.endDate is string
          && resource.data.memberCount is int
          && resource.data.memberCount > 0));
        allow list: if false;
        allow create, update: if previewId == 'current'
          && isTripAdmin(tripId)
          && !isTripClearing(tripId)
          && request.resource.data.keys().hasOnly([
            'tripId', 'tripName', 'description', 'emoji', 'startDate', 'endDate', 'memberCount', 'updatedAt'
          ])
          && request.resource.data.tripId == tripId
          && request.resource.data.tripName == get(/databases/$(database)/documents/trips/$(tripId)).data.name
          && request.resource.data.description == get(/databases/$(database)/documents/trips/$(tripId)).data.get('description', '')
          && request.resource.data.emoji == get(/databases/$(database)/documents/trips/$(tripId)).data.get('emoji', '🧳')
          && request.resource.data.startDate == get(/databases/$(database)/documents/trips/$(tripId)).data.get('startDate', '')
          && request.resource.data.endDate == get(/databases/$(database)/documents/trips/$(tripId)).data.get('endDate', '')
          && request.resource.data.memberCount == get(/databases/$(database)/documents/trips/$(tripId)).data.get('memberIds', get(/databases/$(database)/documents/trips/$(tripId)).data.get('members', [])).size()
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId)
          && !isTripClearing(tripId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidBy in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow update: if canManageTripRecords(tripId) || isReceiptMetadataAppend(tripId, expenseId);
        allow delete: if canManageTripRecords(tripId);

      }

      match /settlements/{settlementId} {
        allow read: if isTripMember(tripId);
        allow create: if canManageSettlements(tripId)
          && !isTripClearing(tripId)
          && request.resource.data.keys().hasOnly([
            'from', 'to', 'amount', 'method', 'settledAt', 'note', 'createdBy'
          ])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.from in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.resource.data.to in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.method in ['cash', 'upi', 'online'];
        allow update: if canManageSettlements(tripId)
          && !isTripClearing(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'from', 'to', 'amount', 'method', 'settledAt', 'note', 'updatedAt'
          ])
          && request.resource.data.from in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.resource.data.to in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.method in ['cash', 'upi', 'online']
          && request.resource.data.get('settledAt', '') is string
          && request.resource.data.get('note', '') is string
          && request.resource.data.updatedAt == request.time
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
        // The active clear-trip owner must still be able to remove settlement
        // records as part of the existing explicit clear workflow.
        allow delete: if canManageTripRecords(tripId)
          || (canManageSettlements(tripId) && !isTripClearing(tripId));
      }

      match /activity/{activityId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId)
          && !isTripClearing(tripId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update: if false;
        allow delete: if canManageTripRecords(tripId);
      }

      function isAdvanceAdmin(tripId) {
        return isTripAdmin(tripId)
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      function sameAdvanceIdentity() {
        return request.resource.data.tripId == resource.data.tripId
          && request.resource.data.memberUid == resource.data.memberUid
          && request.resource.data.amountPaise == resource.data.amountPaise
          && request.resource.data.recordedBy == resource.data.recordedBy
          && request.resource.data.paymentDate == resource.data.paymentDate
          && request.resource.data.reference == resource.data.reference
          && request.resource.data.note == resource.data.note
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.reversalOf == resource.data.reversalOf;
      }

      match /advances/{advanceId} {
        allow read: if isTripMember(tripId);
        allow create: if isAdvanceAdmin(tripId)
          && !isTripClearing(tripId)
          && request.resource.data.keys().hasOnly([
            'tripId', 'memberUid', 'amountPaise', 'recordedBy', 'paymentDate',
            'createdAt', 'reference', 'note', 'status', 'reversalOf'
          ])
          && request.resource.data.tripId == tripId
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.memberUid is string
          && request.resource.data.memberUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0
          && request.resource.data.amountPaise <= 100000000
          && request.resource.data.paymentDate is string
          && request.resource.data.paymentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.reference is string
          && request.resource.data.reference.size() <= 80
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 280
          && (
            (request.resource.data.status == 'recorded' && request.resource.data.reversalOf == '')
            || (request.resource.data.status == 'reversal'
              && request.resource.data.reversalOf is string
              && request.resource.data.reversalOf.size() > 0
              && request.resource.data.reversalOf != advanceId
              && get(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalOf)).data.status == 'recorded'
              && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalOf)).data.status == 'reversed'
              && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalOf)).data.reversalId == advanceId
              && get(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalOf)).data.memberUid == request.resource.data.memberUid
              && get(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalOf)).data.amountPaise == request.resource.data.amountPaise
              && get(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalOf)).data.tripId == tripId)
          );
        allow update: if isAdvanceAdmin(tripId)
          && !isTripClearing(tripId)
          && resource.data.status == 'recorded'
          && request.resource.data.status == 'reversed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversalId', 'reversedAt'])
          && sameAdvanceIdentity()
          && request.resource.data.reversalId is string
          && request.resource.data.reversalId.size() > 0
          && request.resource.data.reversedAt == request.time
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalId)).data.status == 'reversal'
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalId)).data.reversalOf == advanceId
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalId)).data.amountPaise == resource.data.amountPaise
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalId)).data.memberUid == resource.data.memberUid
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/advances/$(request.resource.data.reversalId)).data.recordedBy == request.auth.uid;
        allow delete: if canManageTripRecords(tripId);
      }
    }
  }
}
